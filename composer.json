{
    "name": "mgamadeus/ddd-common-translations",
    "description": "Texts, entity translations, app translations, embeddings for mgamadeus/ddd",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-translations",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-translations/issues",
        "source": "https://github.com/ddd-framework/ddd-translations"
    },
    "version": "1.1.2",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "mgamadeus/ddd": "^3.40.0",
        "mgamadeus/ddd-ai": "^3.3.0",
        "mgamadeus/ddd-argus": "^1.7.0",
        "mgamadeus/ddd-common-money": "^1.1.1",
        "mgamadeus/ddd-common-political": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DDD\\Tests\\Translations\\": "tests/"
        }
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\Translations\\TranslationsModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
